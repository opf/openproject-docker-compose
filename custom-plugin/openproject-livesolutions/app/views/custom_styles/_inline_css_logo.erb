<%#--
  Live Solutions branding override for OpenProject logos.
  Replaces the default OpenProject wordmark and icon with Live Solutions assets.
  Assets are served from /livesolutions-branding/ (mounted public path) to bypass
  the fingerprinted asset pipeline.
--%>

<style type="text/css">
  /* Widen the logo containers so the full LS wordmark fits. */
  .op-logo,
  .op-logo--link,
  .op-logo--icon {
    width: 260px !important;
    max-width: 260px !important;
  }

  .op-logo--icon {
    /* The icon mark is square-ish; keep it from stretching too wide. */
    width: 48px !important;
    max-width: 48px !important;
  }

  .op-logo--link {
    background-image: url(/livesolutions-branding/logo_openproject.png);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: left center;
    display: inline-block !important;
    width: 100% !important;
    height: 100% !important;
  }

  .op-logo--icon {
    background-image: url(/livesolutions-branding/icon_logo.png);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .op-logo--icon_white {
    background-image: url(/livesolutions-branding/icon_logo_white.png);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .op-logo--link_high_contrast {
    background-image: url(/livesolutions-branding/logo_openproject_white_big.png);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: left center;
    display: inline-block !important;
    width: 100% !important;
    height: 100% !important;
  }
</style>
